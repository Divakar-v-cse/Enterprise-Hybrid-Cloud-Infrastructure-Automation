# =============================================================================
# Enterprise Hybrid Cloud Infrastructure Automation - local environment
# Copy to .env and adjust. NEVER commit the real .env file.
# =============================================================================

# ---- API runtime ------------------------------------------------------------
HCCP_ENVIRONMENT=local
HCCP_LOG_LEVEL=INFO
HCCP_PROVIDER=mock
HCCP_AWS_REGION=ap-south-1
HCCP_SEED_DEMO_DATA=true

# ---- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HCCP_SECRET_KEY=change-me-generate-a-random-48-byte-secret
HCCP_ACCESS_TOKEN_TTL_MINUTES=60
HCCP_REFRESH_TOKEN_TTL_DAYS=7
HCCP_LOGIN_MAX_ATTEMPTS=5
HCCP_LOGIN_LOCKOUT_SECONDS=300

# Comma-free JSON list of allowed browser origins
HCCP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Background drift detection --------------------------------------------
# 0 disables the in-process scheduler (CI drives it instead)
HCCP_DRIFT_INTERVAL_SECONDS=0

# ---- Demo accounts (seeded only when HCCP_SEED_DEMO_DATA=true) -------------
# Passwords are intentionally simple for local use only.
HCCP_DEMO_ADMIN_PASSWORD=Admin#2026
HCCP_DEMO_OPERATOR_PASSWORD=Operator#2026
HCCP_DEMO_APPROVER_PASSWORD=Approver#2026
HCCP_DEMO_VIEWER_PASSWORD=Viewer#2026

# ---- AWS (only needed when HCCP_PROVIDER=aws) -------------------------------
# Prefer SSO / instance profiles / OIDC in CI. Do not commit keys.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
