# Managed by Ansible - {{ app_name }}
server {
    listen {{ app_port }} default_server;
    server_name _;
    server_tokens {{ nginx_server_tokens }};
    client_max_body_size {{ nginx_client_max_body_size }};
    root {{ webapp_root }};

    # Security headers (the ALB adds HSTS at the edge)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location = {{ app_health_path }} {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
{% if app_upstream %}
        proxy_pass http://{{ app_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
{% else %}
        try_files $uri $uri/ /index.html;
{% endif %}
    }

    location ~ /\. {
        deny all;
    }
}

# Structured access log consumed by the observability pipeline
log_format hccp_json escape=json
  '{"time":"$time_iso8601","remote_addr":"$remote_addr","request":"$request",'
  '"status":$status,"bytes":$body_bytes_sent,"upstream_time":"$upstream_response_time"}';
access_log /var/log/nginx/hccp-access.log hccp_json;
