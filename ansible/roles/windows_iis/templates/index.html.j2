<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ iis_site_name }} - {{ environment_name | default('dev') }}</title>
    <style>
      body { font-family: "Segoe UI", system-ui, sans-serif; background: #0b1220; color: #e5e7eb; margin: 0; }
      main { max-width: 40rem; margin: 12vh auto; padding: 2rem; border: 1px solid #1f2937; border-radius: 12px; }
      code { color: #93c5fd; }
    </style>
  </head>
  <body>
    <main>
      <h1>{{ iis_site_name }} (Windows Server / IIS)</h1>
      <p>Environment: <code>{{ environment_name | default('dev') }}</code></p>
      <p>Configured by Ansible. Health endpoint: <code>/health.txt</code></p>
      <p>Managed runtime, TLS 1.2+ only, legacy protocols disabled.</p>
    </main>
  </body>
</html>
